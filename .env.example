
# Application port
PORT=3000

# URL for the jsreport service
JSREPORT_URL=
JSREPORT_USER=
JSREPORT_PASS=
# Whether to save a local copy of the resulting reports
JSREPORT_SAVE_LOCAL=true

# Static token for secure API usage
# All API requests are required to have this bearer token
STATIC_TOKEN=abcde

# Database connection string (postgres)
DATABASE_URL=postgres://postgres:postgres@localhost/adapter?sslmode=disable
